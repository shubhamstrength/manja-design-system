{
  "name": "@manja/angular-playground",
  "version": "0.0.0",
  "private": true,
  "description": "Local playground for exercising the Manja Design System in Angular",
  "scripts": {
    "serve": "ng serve",
    "build": "ng build",
    "typecheck": "ngc -p tsconfig.app.json --noEmit",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@angular/common": "22.1.0",
    "@angular/compiler": "22.1.0",
    "@angular/core": "22.1.0",
    "@angular/platform-browser": "22.1.0",
    "@manja/angular": "workspace:*",
    "@manja/styles": "workspace:*",
    "@manja/tokens": "workspace:*",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.3",
    "@angular/cli": "22.1.3",
    "@angular/compiler-cli": "22.1.0",
    "typescript": "6.0.3"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/dist"
        ]
      },
      "serve": {
        "dependsOn": [
          "^build"
        ],
        "cache": false
      }
    }
  }
}
