{
  "name": "@manja/react-playground",
  "version": "0.0.0",
  "private": true,
  "description": "Local playground for exercising the Manja Design System in React",
  "type": "module",
  "scripts": {
    "serve": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src vite.config.ts --max-warnings 0"
  },
  "dependencies": {
    "@manja/core": "workspace:*",
    "@manja/react": "workspace:*",
    "@manja/styles": "workspace:*",
    "@manja/tokens": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "6.0.3",
    "vite": "8.2.1"
  },
  "nx": {
    "targets": {
      "serve": {
        "dependsOn": [
          "^build"
        ],
        "cache": false
      }
    }
  }
}
