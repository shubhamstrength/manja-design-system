{
  "name": "@manja/styles",
  "version": "0.0.0",
  "description": "Global stylesheet for the Manja Design System — tokens, reset, base and utility layers",
  "license": "MIT",
  "type": "module",
  "sideEffects": true,
  "files": [
    "dist",
    "src"
  ],
  "types": "./dist/manja.d.ts",
  "exports": {
    ".": {
      "types": "./dist/manja.d.ts",
      "default": "./dist/manja.css"
    },
    "./min": {
      "types": "./dist/manja.d.ts",
      "default": "./dist/manja.min.css"
    },
    "./reset": {
      "types": "./dist/manja.d.ts",
      "default": "./dist/reset.css"
    },
    "./base": {
      "types": "./dist/manja.d.ts",
      "default": "./dist/base.css"
    },
    "./utilities": {
      "types": "./dist/manja.d.ts",
      "default": "./dist/utilities.css"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node build.mjs",
    "lint": "eslint build.mjs --max-warnings 0"
  },
  "devDependencies": {
    "@manja/tokens": "workspace:*",
    "lightningcss": "1.33.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
